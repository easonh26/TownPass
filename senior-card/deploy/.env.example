# Copy to .env and fill in. NEVER commit .env (it holds a secret).
# Get the token from Cloudflare dashboard:
#   Zero Trust -> Networks -> Tunnels -> <your tunnel> -> Configure -> Install connector
# Public hostname in the dashboard must point at http://web:80
CLOUDFLARE_TUNNEL_TOKEN=
# Informational only (used for the App MICROSERVICE_URL, not by compose):
PUBLIC_HOSTNAME=https://cdf19.twread.net/
